local lastClick = 0
OpenBtn.MouseButton1Click:Connect(function()
    local currentTime = tick()
    PlayClickSound()
    if (currentTime - lastClick) < 0.35 then 
        CloseConfirmFrame.Visible = true 
    else 
        ToggleMenu(not MainFrame.Visible)
    end
    lastClick = currentTime
end)
